# ═══════════════════════════════════════════════════════════════
# Benny's Discord Bot — .env (Cybrancee / /home/container/.env)
# ═══════════════════════════════════════════════════════════════

# ─── Discord (PÅKRÆVET) ───────────────────────────────────────
DISCORD_TOKEN=din_bot_token
DISCORD_CLIENT_ID=din_application_client_id
DISCORD_GUILD_ID=din_server_id

# ─── Intents (skal være true) ─────────────────────────────────
MESSAGE_CONTENT=true
MEMBER_INTENT=true

# ─── Features ───────────────────────────────────────────────────
MODERATION=true
SECURITY=true
AUTO_EXIT=false
AUTO_DEPLOY_COMMANDS=1

# ─── Tickets & bot ──────────────────────────────────────────────
TICKET_INACTIVE_HOURS=72
LOG_LEVEL=info
COOLDOWN_MS=3000

# ─── AI (Groq) — ,ai / pris / faktura ─────────────────────────
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_PAYROLL_AUTO_SCAN=true
PRIS_AUTO_SCAN=false

# ─── Dashboard + Supabase (til Vercel dashboard + online transcripts) ─
DASHBOARD_ENABLED=true
DASHBOARD_APP_URL=https://project-jg1cq.vercel.app
SUPABASE_URL=https://dit-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# DISCORD_CLIENT_SECRET behøves KUN på bot hvis du bruger den dér — ellers kun i Vercel

# ═══════════════════════════════════════════════════════════════
# Vercel dashboard (.env — KUN i Vercel Environment Variables)
# Se dashboard/.env.example — IKKE i bot .env
# ═══════════════════════════════════════════════════════════════
# NEXT_PUBLIC_APP_URL=https://project-jg1cq.vercel.app
# DISCORD_CLIENT_ID=samme som ovenfor
# DISCORD_CLIENT_SECRET=fra Developer Portal → OAuth2
# DISCORD_GUILD_ID=samme som ovenfor
# DISCORD_BOT_TOKEN=samme som DISCORD_TOKEN
# SUPABASE_URL=samme som bot
# SUPABASE_SERVICE_ROLE_KEY=samme som bot
# SESSION_SECRET=tilfældig lang streng min 32 tegn
# DASHBOARD_STAFF_ROLES=Mekaniker,Lærling,Ledelse,Med-ejer,Stifter
